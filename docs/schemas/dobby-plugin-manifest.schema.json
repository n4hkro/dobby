{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobby.local/schemas/dobby-plugin-manifest.schema.json",
  "title": "Dobby Plugin Manifest v1 (Legacy)",
  "description": "Frozen legacy v1 schema for signed .dobbyplugin manifest.json files. New GA installs require dobby-plugin-manifest-v2.schema.json; see artifact-compatibility-matrix.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pluginId",
    "version",
    "vendorId",
    "minHostVersion",
    "entryAssembly",
    "displayName",
    "description",
    "dependsOn",
    "capabilities",
    "operationTargets",
    "extensionPoints",
    "files",
    "signature"
  ],
  "properties": {
    "pluginId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "vendorId": {
      "type": "string",
      "minLength": 1
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "entryAssembly": {
      "$ref": "#/$defs/packageRelativePath"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/packageRelativePath"
        }
      }
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pluginId",
          "minVersion"
        ],
        "properties": {
          "pluginId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
          },
          "minVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          }
        }
      },
      "default": []
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "scope"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "shell",
              "plugin-page",
              "background-task"
            ]
          }
        }
      },
      "default": []
    },
    "operationTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "verbs",
          "labelKey"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/operationTargetId"
          },
          "verbs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "view",
                "create",
                "update",
                "delete",
                "execute",
                "import",
                "export",
                "print",
                "configure",
                "grant"
              ]
            }
          },
          "labelKey": {
            "$ref": "#/$defs/resourceKey"
          }
        }
      },
      "default": []
    },
    "extensionPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "routeKey"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/localIdentifier"
          },
          "target": {
            "type": "string",
            "enum": [
              "top-toolbar",
              "sidebar",
              "third-bar",
              "plugin-page-region"
            ]
          },
          "routeKey": {
            "$ref": "#/$defs/routeKey"
          },
          "labelKey": {
            "$ref": "#/$defs/resourceKey"
          },
          "parentId": {
            "$ref": "#/$defs/localIdentifier"
          },
          "group": {
            "type": "string",
            "const": "default",
            "default": "default"
          },
          "weight": {
            "type": "integer",
            "minimum": -1000000,
            "maximum": 1000000,
            "default": 100
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "target": {
                  "const": "top-toolbar"
                }
              },
              "required": [
                "target"
              ]
            },
            "then": {},
            "else": {
              "required": [
                "labelKey"
              ]
            }
          }
        ]
      },
      "default": []
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/packageRelativePath"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyVersion",
        "value"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "const": "ECDSA-P256-SHA256"
        },
        "keyVersion": {
          "type": "integer",
          "const": 1,
          "description": "Legacy numeric keyVersion selector, frozen at 1 for compatibility reading only. This const is never widened for rotation: the canonical selector is the keyId string governed by ADR-0062 section 4, and new artifacts, schemas and code do not emit keyVersion."
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    }
  },
  "$defs": {
    "localIdentifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "operationTargetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$"
    },
    "packageRelativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "(^/)|(^[A-Za-z]:)|(^\\\\\\\\)|(^\\.\\.?$)|(^\\.\\./)|(\\.\\./)|(/\\.\\.?/)|(\\\\)"
          },
          {
            "pattern": "[\\u0000-\\u001F]"
          }
        ]
      }
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "routeKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    }
  }
}
