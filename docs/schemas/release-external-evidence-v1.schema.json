{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobby.local/schemas/release-external-evidence-v1.schema.json",
  "title": "Dobby External Release Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "sourceCommit", "generatedAtUtc", "status", "claims", "subjects"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gate": {
      "enum": ["installed-msix-upgrade", "production-signing", "license-review"]
    },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "status": { "const": "passed" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 96 }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
