{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dobby.local/schemas/dobby-plugin-license-v3.schema.json",
  "title": "Dobby Plugin License Artifact v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signature"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "purpose", "keyId", "licenseId", "revisionSeriesId", "licenseRevision", "pluginId", "customerId", "deploymentId", "deviceKeyHash", "packageFingerprint", "issuedAt", "notBefore", "expiresAt", "gracePeriodDays", "intent"],
      "properties": {
        "schemaVersion": { "type": "integer", "const": 3 },
        "purpose": { "type": "string", "const": "dobby.plugin-license" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "licenseId": { "$ref": "#/$defs/id" },
        "revisionSeriesId": { "$ref": "#/$defs/id" },
        "licenseRevision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "pluginId": { "$ref": "#/$defs/pluginId" },
        "customerId": { "$ref": "#/$defs/id" },
        "deploymentId": { "$ref": "#/$defs/id" },
        "deviceKeyHash": { "$ref": "#/$defs/sha256" },
        "packageFingerprint": { "$ref": "#/$defs/sha256" },
        "issuedAt": { "$ref": "#/$defs/utc" },
        "notBefore": { "$ref": "#/$defs/utc" },
        "expiresAt": { "$ref": "#/$defs/utc" },
        "gracePeriodDays": { "type": "integer", "minimum": 0, "maximum": 365 },
        "intent": { "type": "string", "enum": ["granted", "revoked"] }
      }
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "pluginId": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$" },
    "keyId": { "type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "utc": { "type": "string", "maxLength": 35, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "algorithm", "format", "keyId", "value"],
      "properties": {
        "purpose": { "type": "string", "const": "dobby.plugin-license" },
        "algorithm": { "type": "string", "const": "ECDSA-P256-SHA256" },
        "format": { "type": "string", "const": "IeeeP1363FixedFieldConcatenation" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "value": { "type": "string", "minLength": 86, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  }
}
