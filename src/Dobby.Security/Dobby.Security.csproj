<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DobbyPluginTrustProfile Condition="'$(DobbyPluginTrustProfile)' == ''">Production</DobbyPluginTrustProfile>
  </PropertyGroup>
  <ItemGroup Condition="'$(DobbyPluginTrustProfile)' == 'Production'">
    <EmbeddedResource
        Include="..\Dobby.Host\Trust\vendor-master-public-key.pem"
        Link="Trust\vendor-master-public-key.pem"
        LogicalName="Dobby.Security.Trust.vendor-master-public-key.pem" />
  </ItemGroup>
  <ItemGroup Condition="'$(DobbyPluginTrustProfile)' == 'DevQa'">
    <EmbeddedResource
        Include="..\Dobby.Host\Trust\dev-qa-public-key.pem"
        Link="Trust\dev-qa-public-key.pem"
        LogicalName="Dobby.Security.Trust.dev-qa-public-key.pem" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DobbyPluginTrustProfile</_Parameter1>
      <_Parameter2>$(DobbyPluginTrustProfile)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Dobby.Host</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Dobby.UnitTests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Dobby.IntegrationTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Dobby.Configuration\Dobby.Configuration.csproj" />
    <ProjectReference Include="..\Dobby.Contracts\Dobby.Contracts.csproj" />
    <ProjectReference Include="..\Dobby.Core\Dobby.Core.csproj" />
    <ProjectReference Include="..\Dobby.Infrastructure\Dobby.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="ValidateDobbyPluginTrustProfile" BeforeTargets="PrepareForBuild">
    <Error
        Condition="'$(DobbyPluginTrustProfile)' != 'Production' and '$(DobbyPluginTrustProfile)' != 'DevQa'"
        Text="DobbyPluginTrustProfile must be Production or DevQa." />
    <Error
        Condition="'$(DobbyPluginTrustProfile)' == 'Production' and !Exists('..\Dobby.Host\Trust\vendor-master-public-key.pem')"
        Text="Production plugin trust public key is missing." />
    <Error
        Condition="'$(DobbyPluginTrustProfile)' == 'DevQa' and !Exists('..\Dobby.Host\Trust\dev-qa-public-key.pem')"
        Text="Dev/QA plugin trust public key is missing." />
  </Target>
</Project>
