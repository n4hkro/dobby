{
  "Dobby": {
    "Runtime": {
      "DataRoot": "%LocalAppData%/Dobby",
      "EnvironmentName": "Production"
    },
    "Storage": {
      "ProviderMode": "SQLite3MultipleCiphers",
      "RequireDataAtRestProtection": true,
      "BusyTimeoutMilliseconds": 5000
    },
    "Auth": {
      "LoginThrottleStepsSeconds": [ 0, 0, 10, 30, 60 ],
      "PasswordKdfMode": "Pbkdf2Sha256",
      "LoginThrottleFailureWindowSeconds": 900,
      "LoginGlobalFailureThreshold": 10,
      "LoginGlobalBackoffSeconds": 60,
      "MaxConcurrentPasswordVerifications": 2
    },
    "Session": {
      "AbsoluteTimeoutMinutes": 480,
      "IdleTimeoutMinutes": 30,
      "AutoLockEnabledByDefault": false
    },
    "Diagnostics": {
      "TechnicalLogRetentionDays": 30,
      "TechnicalLogTotalSizeCapMegabytes": 256
    },
    "Audit": {
      "RetentionDays": 365
    },
    "Localization": {
      "DefaultCulture": "az-AZ",
      "SupportedCultures": [ "az-AZ", "en-US", "tr-TR" ]
    },
    "Plugins": {
      "AllowPreLoginDiscovery": false,
      "MaximumCompressedPackageMegabytes": 64,
      "MaximumManifestKilobytes": 256,
      "MaximumEntryCount": 256,
      "MaximumEntryUncompressedMegabytes": 64,
      "MaximumAggregateUncompressedMegabytes": 256,
      "MaximumExpansionRatio": 50
    },
    "Licensing": {
      "ImportRequiresPermission": true
    },
    "Product": {
      "SupportContact": "https://github.com/n4hkro/dobby/issues",
      "LegalLine": "Copyright © 2026 Dobby contributors",
      "ArtifactMode": "Installed"
    },
    "BranchShared": {
      "RuntimeEnabled": false
    }
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
