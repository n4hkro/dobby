<Window
    x:Class="Dobby.Host.Login.RecoveryPasswordResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="320"
    MinWidth="420"
    MinHeight="260"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Dobby.Brush.Background}">
  <Grid Margin="24">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="NewPasswordLabel" Foreground="{DynamicResource Dobby.Brush.Text}" TextWrapping="Wrap" />
      <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12" AutomationProperties.AutomationId="Dobby.Host.Recovery.NewPassword" AutomationProperties.LabeledBy="{Binding ElementName=NewPasswordLabel}" AutomationProperties.Name="{Binding Text, ElementName=NewPasswordLabel}" TabIndex="0" />
      <TextBlock x:Name="ConfirmPasswordLabel" Foreground="{DynamicResource Dobby.Brush.Text}" TextWrapping="Wrap" />
      <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,12" AutomationProperties.AutomationId="Dobby.Host.Recovery.ConfirmPassword" AutomationProperties.LabeledBy="{Binding ElementName=ConfirmPasswordLabel}" AutomationProperties.Name="{Binding Text, ElementName=ConfirmPasswordLabel}" TabIndex="1" />
      <TextBlock x:Name="ValidationText" Margin="0,0,0,12" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="Crimson" TextWrapping="Wrap" Visibility="Collapsed" />
      <WrapPanel>
        <Button x:Name="ConfirmButton" MinWidth="96" AutomationProperties.AutomationId="Dobby.Host.Recovery.Confirm" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" Click="Confirm_Click" IsDefault="True" TabIndex="2" />
        <Button x:Name="CancelButton" Margin="8,0,0,0" AutomationProperties.AutomationId="Dobby.Host.Recovery.Cancel" AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}" Click="Cancel_Click" IsCancel="True" TabIndex="3" />
      </WrapPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
