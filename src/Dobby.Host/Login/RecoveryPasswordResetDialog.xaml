<Window
    x:Class="Dobby.Host.Login.RecoveryPasswordResetDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="260"
    MinWidth="420"
    MinHeight="260"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource Dobby.Brush.Background}">
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center">
      <TextBlock x:Name="NewPasswordLabel" Foreground="{DynamicResource Dobby.Brush.Text}" />
      <PasswordBox x:Name="NewPasswordBox" Margin="0,4,0,12" />
      <TextBlock x:Name="ConfirmPasswordLabel" Foreground="{DynamicResource Dobby.Brush.Text}" />
      <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,4,0,16" />
      <StackPanel Orientation="Horizontal">
        <Button x:Name="ConfirmButton" Width="96" Click="Confirm_Click" />
        <Button x:Name="CancelButton" Margin="8,0,0,0" Click="Cancel_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
