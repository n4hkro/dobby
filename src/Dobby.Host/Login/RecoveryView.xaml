<UserControl
    x:Class="Dobby.Host.Login.RecoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
    <StackPanel>
      <TextBlock
          x:Name="RecoveryTitleText"
          Margin="0,0,0,12"
          FontSize="18"
          Foreground="{DynamicResource Dobby.Brush.Text}" />
      <Button x:Name="ExportRequestButton" Margin="0,0,0,8" Click="Export_Click" />
      <TextBlock
          x:Name="ExportPathText"
          Margin="0,0,0,8"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          TextWrapping="Wrap"
          Visibility="Collapsed" />
      <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
        <Button
            x:Name="OpenFolderButton"
            Click="OpenFolder_Click"
            Visibility="Collapsed" />
        <Button
            x:Name="CopyPathButton"
            Margin="8,0,0,0"
            Click="CopyPath_Click"
            Visibility="Collapsed" />
      </StackPanel>
      <Button x:Name="ImportResponseButton" Margin="0,0,0,8" Click="Import_Click" />
      <TextBlock
          x:Name="ImportPathText"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          TextWrapping="Wrap"
          Visibility="Collapsed" />
    </StackPanel>
  </Grid>
</UserControl>
