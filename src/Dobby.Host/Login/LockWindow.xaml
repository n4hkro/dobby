<Window
    x:Class="Dobby.Host.Login.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    Width="420"
    Height="260"
    MinWidth="420"
    MinHeight="260"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Dobby.Brush.Background}">
  <Grid Margin="24">
    <StackPanel VerticalAlignment="Center">
      <TextBlock
          x:Name="LockTitleText"
          Margin="0,0,0,16"
          FontSize="20"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="" />
      <TextBlock
          x:Name="LockedUserText"
          Margin="0,0,0,12"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="{Binding CurrentUserLabel}"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="PasswordLabel"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="" />
      <PasswordBox
          x:Name="PasswordBox"
          Margin="0,4,0,16"
          PasswordChanged="PasswordBox_PasswordChanged" />
      <TextBlock
          x:Name="ErrorText"
          Margin="0,0,0,16"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="{Binding FeedbackText}"
          TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal">
        <Button
            x:Name="UnlockButton"
            Width="96"
            IsEnabled="{Binding UnlockEnabled}"
            Click="Unlock_Click" />
        <Button
            x:Name="LogoutButton"
            Margin="8,0,0,0"
            IsEnabled="{Binding LogoutEnabled}"
            Click="Logout_Click" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
