<Window
    x:Class="Dobby.Host.Login.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title=""
    Width="420"
    Height="260"
    MinWidth="420"
    MinHeight="260"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource Dobby.Brush.Background}">
  <Grid Margin="24">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel VerticalAlignment="Center">
      <TextBlock
          x:Name="LockTitleText"
          Margin="0,0,0,16"
          FontSize="20"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text=""
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="LockedUserText"
          Margin="0,0,0,12"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="{Binding CurrentUserLabel}"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="PasswordLabel"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text=""
          TextWrapping="Wrap" />
      <PasswordBox
          x:Name="PasswordBox"
          Margin="0,4,0,16"
          AutomationProperties.AutomationId="Dobby.Host.Lock.Password"
          AutomationProperties.LabeledBy="{Binding ElementName=PasswordLabel}"
          AutomationProperties.Name="{Binding Text, ElementName=PasswordLabel}"
          TabIndex="0"
          PasswordChanged="PasswordBox_PasswordChanged" />
      <TextBlock
          x:Name="ErrorText"
          Margin="0,0,0,16"
          AutomationProperties.LiveSetting="Assertive"
          AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}"
          Foreground="{DynamicResource Dobby.Brush.Text}"
          Text="{Binding FeedbackText}"
          TextWrapping="Wrap" />
      <WrapPanel>
        <Button
            x:Name="UnlockButton"
            MinWidth="96"
            AutomationProperties.AutomationId="Dobby.Host.Lock.Unlock"
            AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
            IsEnabled="{Binding UnlockEnabled}"
            IsDefault="True"
            TabIndex="1"
            Click="Unlock_Click" />
        <Button
            x:Name="LogoutButton"
            Margin="8,0,0,0"
            AutomationProperties.AutomationId="Dobby.Host.Lock.Logout"
            AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
            IsEnabled="{Binding LogoutEnabled}"
            TabIndex="2"
            Click="Logout_Click" />
      </WrapPanel>
    </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
